<?xml version="1.0" encoding="utf-8"?>
<!--
  简体中文版的安装向导文案（覆盖上游 packaging/windows/photocraft.en-us.wxl）。

  上游 v0.17.0 起自带完整的安装向导（<ui:WixUI Id="WixUI_InstallDir"> + 作用域选择页），
  我们不再自建 installer-ui.wxs —— 那套覆盖一旦遇上上游改安装界面就会失效（10-29 就是如此）。
  改用「本地化文件」这条更稳的路：只覆盖文案，不碰上游的界面结构。

  用法：package.ps1 的 wix build 调用里把 -loc 指向本文件（-culture 仍为 en-US，
  这样 WiX 内置的其余英文文案不会缺失；本文件里覆盖到的就是中文）。
  String Id 沿用 WiX 标准向导的命名（WixUI_*.wxl），WiX 5 的 id 基本稳定。
-->
<WixLocalization Culture="en-US" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <!-- 上游自定义的 6 条（[PhotocraftVersion] 由 photocraft.wxs 提供）-->
  <String Id="WelcomeDlgTitle" Value="{\WixUI_Font_Bigger}欢迎使用 [ProductName] [PhotocraftVersion] 安装向导" />
  <String Id="WelcomeDlgDescription" Value="安装向导将把 [ProductName] [PhotocraftVersion] 安装到你的电脑上。点「下一步」继续，或点「取消」退出安装向导。" />
  <String Id="VerifyReadyDlgInstallTitle" Value="{\WixUI_Font_Title}准备安装 [ProductName] [PhotocraftVersion]" />
  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}[ProductName] [PhotocraftVersion] 安装向导已完成" />
  <String Id="PhotocraftInstallDirNote" Value="仅安装到当前账户自己的程序目录，不需要管理员权限。" />
  <String Id="PhotocraftAllUsers" Value="为这台电脑上的所有用户安装（需要管理员权限）" />

  <!-- WiX 标准向导文案：按钮 -->
  <String Id="CommonButtonNext" Value="下一步" />
  <String Id="CommonButtonBack" Value="上一步" />
  <String Id="CommonButtonCancel" Value="取消" />
  <String Id="CommonButtonYes" Value="是" />
  <String Id="CommonButtonNo" Value="否" />
  <String Id="CommonButtonFinish" Value="完成" />
  <String Id="CommonButtonInstall" Value="安装" />
  <String Id="CommonButtonUninstall" Value="卸载" />
  <String Id="CommonButtonOk" Value="确定" />

  <!-- 欢迎页 / 安装目录页 -->
  <String Id="InstallDirDlgTitle" Value="{\WixUI_Font_Bigger}选择安装位置" />
  <String Id="InstallDirDlgDescription" Value="请选择 [ProductName] 的安装文件夹。" />
  <String Id="FolderLabel" Value="文件夹:" />
  <String Id="PathLabel" Value="文件夹名:" />
  <String Id="ChangeInstallDirectory" Value="更改…" />

  <!-- 准备安装页 -->
  <String Id="VerifyReadyDlgInstallText" Value="点击「安装」开始安装 [ProductName]。" />
  <String Id="VerifyReadyDlgChange" Value="更改" />
  <String Id="VerifyReadyDlgChangeMsi" Value="更改" />
  <String Id="VerifyReadyDlgBack" Value="上一步" />

  <!-- 进度页 / 完成页 -->
  <String Id="ProgressDlgTitle" Value="{\WixUI_Font_Bigger}正在安装 [ProductName]" />
  <String Id="ProgressDlgText" Value="请稍候，正在安装。" />
  <String Id="ProgressDlgSubText" Value="正在安装 {0}。" />
  <String Id="ProgressDlgStatusTitle" Value="正在安装" />
  <String Id="ProgressDlgStatusText" Value="状态: {0}" />
  <String Id="ExitDialogDescription" Value="点击「完成」关闭此向导。" />
  <String Id="ExitDialogFinishButton" Value="完成" />

  <!-- 取消确认页 -->
  <String Id="CancelDialogTitle" Value="取消安装" />
  <String Id="CancelDialogText" Value="确定要取消 [ProductName] 的安装吗?" />

  <!-- 维护（修复/卸载）页 -->
  <String Id="MaintenanceForm_Title" Value="{\WixUI_Font_Bigger}维护 [ProductName]" />
  <String Id="MaintenanceForm_ActionRepair" Value="修复" />
  <String Id="MaintenanceForm_ActionRemove" Value="移除" />
  <String Id="MaintenanceForm_Header" Value="选择要进行的操作。" />
  <String Id="MaintenanceForm_Reshaping" Value="正在修复…" />
  <String Id="MaintenanceForm_Removing" Value="正在移除…" />
</WixLocalization>
