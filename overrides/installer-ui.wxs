<?xml version="1.0" encoding="utf-8"?>
<!-- PhotoCraft 简体中文版：自选安装位置的安装界面（纯文本原生 MSI 对话框，不依赖任何 WiX UI 扩展，
     也不需要自定义动作 DLL）。

     与 PdfCraft 那个姊妹项目的做法的区别（重要）：
       上游 photocraft 的 packaging/windows/photocraft.wxs **本身没有任何界面定义**
       （没有 <UIRef>、没有对话框），安装包只有 Windows 最简进度界面，装到固定的
       C:\Program Files\PhotoCraft。所以：

       1. 这里定义的是一个**新增**的具名 UI（PhotocraftInstallerUI），不是替换上游界面。
       2. 构建时由工作流做两处**极小注入**把它接上：
            - photocraft.wxs：插入一行 <UIRef Id="PhotocraftInstallerUI" />
            - package.ps1：把本文件加进 `wix build` 的源文件列表
          这样上游的 wxs 其余内容（文件关联、注册表、组件）保持原样，上游将来改动不会与我们冲突。
       3. 上游没有 test-msi.ps1（PdfCraft 有，会逐项核对界面文案），所以这里没有「不许改文案」的约束。

     INSTALLFOLDER 必须标记 Secure：用户在未提权的界面上选的路径，要能穿过提权边界
     到达真正执行安装的进程，否则 Windows Installer 会把它丢掉。 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="PhotocraftInstallerUI">
      <TextStyle Id="InstallerNormal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="InstallerTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
      <Property Id="DefaultUIFont" Value="InstallerNormal" />

      <!-- ==== 自选安装位置 ==== -->
      <!-- 值必须是「目录 ID」而不是路径：下面所有目录控件的 Indirect="yes" 就是靠它定位目录。 -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
      <!-- 浏览对话框内部用这个属性传递「要浏览哪个目录」，写法照抄 WiX 官方 WixUI。 -->
      <Property Id="_BrowseProperty" Value="INSTALLFOLDER" />
      <!-- 关键：让用户选的路径能穿过提权边界，到达真正执行安装的那个进程。 -->
      <Property Id="INSTALLFOLDER" Secure="yes" />

      <Dialog Id="InstallWelcome" Width="370" Height="195" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Install [ProductName]" />
        <Control Id="Description" Type="Text" X="20" Y="50" Width="330" Height="32"
            Text="Setup will install [ProductName] for all users. You can change the install location below." />

        <!-- 安装位置：可直接编辑，也可按 Browse 选目录 -->
        <Control Id="LocationLabel" Type="Text" X="20" Y="88" Width="330" Height="12" TabSkip="no"
            Text="Install &amp;location:" />
        <Control Id="LocationPath" Type="PathEdit" X="20" Y="102" Width="238" Height="18"
            Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="LocationBrowse" Type="PushButton" X="266" Y="102" Width="82" Height="18" Text="&amp;Browse...">
          <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="SpawnDialog" Value="InstallLocationBrowser" Order="2" />
        </Control>

        <Control Id="Install" Type="PushButton" X="195" Y="160" Width="75" Height="23" Default="yes" ElevationShield="yes" Text="&amp;Install">
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="160" Width="70" Height="23" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- ==== 目录浏览对话框（结构照抄 WiX 官方 BrowseDlg，去掉图标/位图装饰）====
           确定：SetTargetPath [_BrowseProperty] 把选中路径应用到目录。
           取消：先 Reset 丢弃改动，再关闭——因为上面的控件是 Indirect 直接编辑目录目标的。 -->
      <Dialog Id="InstallLocationBrowser" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Text="{\InstallerTitle}Change install location" />
        <Control Id="ComboLabel" Type="Text" X="20" Y="50" Width="60" Height="12" TabSkip="no" Text="Look &amp;in:" />
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="82" Y="47" Width="228" Height="80"
            Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes" Removable="yes">
          <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
        </Control>
        <Control Id="Up" Type="PushButton" X="314" Y="47" Width="36" Height="18" Text="&amp;Up">
          <Publish Event="DirectoryListUp" Value="0" />
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="20" Y="75" Width="330" Height="98"
            Property="_BrowseProperty" Indirect="yes" Sunken="yes" TabSkip="no" />
        <Control Id="PathLabel" Type="Text" X="20" Y="180" Width="330" Height="12" TabSkip="no" Text="Folder &amp;name:" />
        <Control Id="PathEdit" Type="PathEdit" X="20" Y="194" Width="330" Height="18"
            Property="_BrowseProperty" Indirect="yes" />
        <Control Id="OK" Type="PushButton" X="195" Y="232" Width="75" Height="23" Default="yes" Text="OK">
          <Publish Event="SetTargetPath" Value="[_BrowseProperty]" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="232" Width="70" Height="23" Cancel="yes" Text="Cancel">
          <Publish Event="Reset" Value="0" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
      </Dialog>

      <Dialog Id="InstallMaintenance" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Maintain [ProductName]" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70"
            Text="[ProductName] is already installed. Choose Repair to restore missing files and shortcuts, or Remove to uninstall it." />
        <Control Id="Repair" Type="PushButton" X="110" Y="145" Width="75" Height="23" Default="yes" ElevationShield="yes" Text="&amp;Repair">
          <Publish Property="REINSTALL" Value="ALL" Order="1" />
          <Publish Property="REINSTALLMODE" Value="amus" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="195" Y="145" Width="75" Height="23" ElevationShield="yes" Text="R&amp;emove">
          <Publish Property="REMOVE" Value="ALL" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="145" Width="70" Height="23" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="InstallProgress" Width="370" Height="180" Title="[ProductName] Setup" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Setting up [ProductName]" />
        <Control Id="Status" Type="Text" X="20" Y="60" Width="330" Height="40" Text="Please wait while setup completes." />
        <Control Id="Progress" Type="ProgressBar" X="20" Y="110" Width="330" Height="15" ProgressBlocks="yes">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="145" Width="70" Height="23" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="ConfirmCancel" />
        </Control>
      </Dialog>

      <Dialog Id="ConfirmCancel" Width="300" Height="110" Title="Cancel setup">
        <Control Id="Description" Type="Text" X="20" Y="20" Width="260" Height="35" Text="Cancel [ProductName] setup?" />
        <Control Id="Yes" Type="PushButton" X="130" Y="70" Width="70" Height="23" Text="&amp;Yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="210" Y="70" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;No">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallComplete" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Setup completed successfully" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70"
            Text="[ProductName] setup has completed successfully. Click Finish to close this window." />
        <Control Id="Finish" Type="PushButton" X="280" Y="145" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallFailed" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Setup failed" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70"
            Text="[ProductName] setup could not be completed. Resolve the reported error and run setup again." />
        <Control Id="Finish" Type="PushButton" X="280" Y="145" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallCancelled" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Setup cancelled" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70"
            Text="[ProductName] setup was cancelled. Run setup again when you are ready." />
        <Control Id="Finish" Type="PushButton" X="280" Y="145" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Shown by Windows Installer (Restart Manager) when an upgrade or repair must replace files
           that a running PhotoCraft holds open. OK closes those programs (MSIRMSHUTDOWN=2) and
           continues; Cancel ends setup. -->
      <Dialog Id="MsiRMFilesInUse" Width="370" Height="200" Title="[ProductName] Setup" KeepModeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="25" Text="{\InstallerTitle}Files in use" />
        <Control Id="Description" Type="Text" X="20" Y="45" Width="330" Height="30"
            Text="These programs are using files that setup needs to update. Click OK to close them and continue, or Cancel to stop setup." />
        <Control Id="List" Type="ListBox" X="20" Y="80" Width="330" Height="55" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="OK" Type="PushButton" X="195" Y="165" Width="75" Height="23" Default="yes" Text="OK">
          <Publish Property="MSIRMSHUTDOWN" Value="2" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="165" Width="70" Height="23" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="InstallWelcome" Before="InstallMaintenance" Condition="UILevel = 5 AND NOT Installed" />
        <Show Dialog="InstallMaintenance" Before="InstallProgress" Condition="UILevel = 5 AND Installed AND NOT REMOVE AND NOT REINSTALL" />
        <Show Dialog="InstallProgress" Before="ExecuteAction" Condition="UILevel = 5" />
        <Show Dialog="InstallComplete" OnExit="success" Condition="UILevel = 5" />
        <Show Dialog="InstallFailed" OnExit="error" Condition="UILevel = 5" />
        <Show Dialog="InstallCancelled" OnExit="cancel" Condition="UILevel = 5" />
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
